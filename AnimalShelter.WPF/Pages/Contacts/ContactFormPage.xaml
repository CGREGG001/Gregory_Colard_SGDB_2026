<Page x:Class="AnimalShelter.WPF.Pages.Contacts.ContactFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ContentBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Retour"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Message d'erreur -->
            <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding ErrorVisibility}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"/>
            </Border>

            <!-- Formulaire -->
            <StackPanel Grid.Row="2">

                <!-- Identité -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Identité" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Prénom *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nom *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,0"
                                    Visibility="{Binding NationalRegisterVisibility}">
                            <TextBlock Text="Numéro de registre national" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding NationalRegister, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Coordonnées -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Coordonnées" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="GSM" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Gsm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Téléphone" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rôles + RGPD -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rôles" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Bénévole" IsChecked="{Binding IsVolunteer}"
                                          Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                                <CheckBox Content="Adoptant" IsChecked="{Binding IsAdopter}"
                                          Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                                <CheckBox Content="Candidat" IsChecked="{Binding IsCandidate}"
                                          Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                                <CheckBox Content="Autre" IsChecked="{Binding IsOther}"
                                          Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Consentement RGPD" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding RgpdConsentDate}"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Adresse -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Adresse" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Rue" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Numéro" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Boîte" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Box, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Code postal" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding PostCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Ville" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pays" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Boutons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="Enregistrer"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

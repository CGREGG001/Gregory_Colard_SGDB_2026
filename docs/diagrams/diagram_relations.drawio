                <mxCell id="361" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;REGLES :&lt;/font&gt;&lt;/h1&gt;&lt;p style=&quot;margin-top: 0px;&quot;&gt;&lt;u style=&quot;color: rgb(63, 63, 63); font-weight: normal; background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Définition des Enums :&lt;/font&gt;&lt;/u&gt;&lt;/p&gt;&lt;h3 style=&quot;box-sizing: border-box; line-height: 21px; font-optical-sizing: auto; margin-bottom: 18px; color: light-dark(rgb(43, 45, 49), rgb(196, 198, 201));&quot;&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63); font-size: 10px; font-weight: normal;&quot;&gt;Motif : (&#39;Abandon&#39;, &#39;Errant&#39;, &#39;DecesProprio&#39;, &#39;Saisie&#39;, &#39;Retour&#39;)&lt;/span&gt;&lt;/h3&gt;&lt;h3 style=&quot;box-sizing: border-box; line-height: 21px; font-family: Inter, sans-serif; font-optical-sizing: auto; margin-bottom: 18px; color: light-dark(rgb(43, 45, 49), rgb(196, 198, 201));&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: normal;&quot; class=&quot;ng-star-inserted&quot;&gt;&lt;u style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Contraintes (Check croisé) :&lt;/font&gt;&lt;/u&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 10px; font-family: Helvetica; background: none 0% 0% / auto repeat scroll padding-box border-box transparent; font-weight: normal; box-sizing: border-box; border: medium none currentcolor; border-radius: 4px; display: inline-block; padding: 0px 2px; color: rgb(43, 45, 49);&quot; class=&quot;inline-code ng-star-inserted&quot;&gt;CHECK (Motif IN (&#39;Errant&#39;, &#39;Saisie&#39;) OR Id_Personne IS NOT NULL) :&lt;/span&gt;&lt;span style=&quot;font-size: 10px; font-family: Helvetica; background-color: transparent; font-weight: normal; box-sizing: border-box; color: rgb(63, 63, 63);&quot; class=&quot;ng-star-inserted&quot;&gt;Exige un contact si l&#39;animal est aban
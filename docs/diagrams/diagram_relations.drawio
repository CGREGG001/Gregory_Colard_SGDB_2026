e-block; padding: 0px 2px;&quot; class=&quot;inline-code ng-star-inserted&quot;&gt;CREATE UNIQUE INDEX UX_Adoption_Active ON DOSSIER_ADOPTION (Id_Animal, Id_Personne) WHERE Statut = &#39;Demande&#39;;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); box-sizing: border-box;&quot; class=&quot;ng-star-inserted&quot;&gt;&amp;nbsp;: Empêche une même personne de faire deux demandes simultanées en cours pour le même animal.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1" parent="1">

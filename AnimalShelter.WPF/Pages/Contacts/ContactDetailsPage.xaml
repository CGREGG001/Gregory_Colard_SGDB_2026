<Page x:Class="AnimalShelter.WPF.Pages.Contacts.ContactDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ContentBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Retour"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Back_Click" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Contact.FirstName" FallbackValue=""/>
                            <Binding Path="Contact.LastName" FallbackValue="Contact"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Modifier"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Supprimer"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Chargement -->
            <TextBlock Grid.Row="1" Text="Chargement..."
                       Visibility="{Binding LoadingVisibility}"
                       HorizontalAlignment="Center" Margin="0,40,0,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="14"/>

            <StackPanel Grid.Row="1">

                <!-- Informations personnelles -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Informations personnelles"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,24,16">
                                <TextBlock Text="Email" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.Email, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,24,16">
                                <TextBlock Text="GSM" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.Gsm, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Téléphone" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.Phone, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,24,0">
                                <TextBlock Text="Rôles" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.RoleFlags}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,24,0">
                                <TextBlock Text="Consentement RGPD" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.RgpdConsentDate, StringFormat=dd/MM/yyyy, FallbackValue='Non renseigné'}"
                                           Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Adresse -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Adresse"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Rue" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.Street, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="N°" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.Number, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Boîte" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.Box, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Code postal" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.PostCode, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ville" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Contact.City, FallbackValue='—'}" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Animaux en famille d'accueil -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Animaux en famille d'accueil (actuels)"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,12"/>

                        <!-- Formulaire terminer un accueil -->
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding FosterEndFormVisibility}">
                            <StackPanel>
                                <TextBlock Text="Terminer l'accueil"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,8"/>
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                        CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                                        Visibility="{Binding FosterErrorVisibility}">
                                    <TextBlock Text="{Binding FosterErrorMessage}"
                                               Foreground="#DC2626" FontSize="12"/>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Date de fin *" Style="{StaticResource FormLabelStyle}"/>
                                        <DatePicker SelectedDate="{Binding FosterEndDate}"
                                                    BorderBrush="{StaticResource BorderBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Confirmer la fin"
                                            Style="{StaticResource DangerButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding ConfirmFosterEndCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Annuler"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding CancelFosterEndCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding CurrentFosterAnimals}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" RowHeight="36"
                                  Background="White" BorderThickness="0"
                                  CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Animal" Binding="{Binding AnimalName}" Width="*"/>
                                <DataGridTextColumn Header="Depuis" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="140"/>
                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Terminer"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,3" FontSize="12"
                                                    Command="{Binding DataContext.EndFosterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Dossiers d'adoption -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Dossiers d'adoption"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding AdoptionHistory}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" RowHeight="36"
                                  Background="White" BorderThickness="0"
                                  CanUserResizeRows="False" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Animal" Binding="{Binding AnimalName}" Width="*"/>
                                <DataGridTextColumn Header="Date demande" Binding="{Binding RequestDate, StringFormat=dd/MM/yyyy}" Width="130"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Historique des accueils -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Historique des accueils"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding FosterHistory}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" RowHeight="36"
                                  Background="White" BorderThickness="0"
                                  CanUserResizeRows="False" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Animal" Binding="{Binding AnimalName}" Width="*"/>
                                <DataGridTextColumn Header="Début" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="140"/>
                                <DataGridTextColumn Header="Fin" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy, FallbackValue='En cours'}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
